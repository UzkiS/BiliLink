# 由 `uv run poe env-example` 根据 src/bililink/config.py 自动生成，请勿手动编辑。
# 使用方法：复制为 .env，只取消注释并修改需要调整的项。

# 监听地址
# BILILINK_HOST=0.0.0.0

# 监听端口
# BILILINK_PORT=5000

# 受信任的反向代理 IP（逗号分隔，支持 CIDR）。只有来自这些地址的 X-Forwarded-For 才会被当作客户端 IP 用于限流；部署在反向代理之后必须正确设置，直接对外暴露时切勿设为 *
# BILILINK_FORWARDED_ALLOW_IPS=127.0.0.1

# 每个客户端 IP 的限流规则，如 10/minute、100/hour（limits 库的限流字符串语法）
# BILILINK_RATE_LIMIT=10/minute

# B 站登录 Cookie 中的 SESSDATA；留空则以游客身份请求，可获取的画质较低
# BILILINK_SESSDATA=

# 请求 B 站接口的超时时间（秒）
# BILILINK_REQUEST_TIMEOUT=10.0

# 中国大陆访问者（以及内网等无法判断地区的访问者）改写视频直链时使用的 CDN 镜像域名（JSON 数组），每次随机选择一个；设为 [] 则保留 B 站返回的原始域名
# BILILINK_CDN_HOSTS=["upos-sz-mirrorcos.bilivideo.com", "upos-sz-mirrorali.bilivideo.com", "upos-sz-mirror08c.bilivideo.com"]

# 中国大陆以外的访问者改写视频直链时使用的 CDN 镜像域名，规则同 BILILINK_CDN_HOSTS；设为与 BILILINK_CDN_HOSTS 相同即不再按地区区分
# BILILINK_CDN_OVERSEAS_HOSTS=["upos-sz-mirroraliov.bilivideo.com", "upos-sz-mirrorcosov.bilivideo.com"]

# 中国大陆 IP 段自动更新间隔（秒）；启动后在后台立即从 APNIC 更新，之后按此间隔刷新，失败时保留已有数据；设为 0 关闭网络更新
# BILILINK_GEOIP_UPDATE_INTERVAL=86400.0

# 从 APNIC 下载 IP 段数据的超时时间（秒）
# BILILINK_GEOIP_UPDATE_TIMEOUT=60.0

# IP 段缓存文件路径；留空仅更新内存，兼容只读容器；设置后启动时优先读取缓存，并在更新成功后写入，容器中需挂载可写目录
# BILILINK_GEOIP_CACHE_FILE=

# 日志级别：DEBUG、INFO、WARNING、ERROR 或 CRITICAL
# BILILINK_LOG_LEVEL=INFO

# 是否开放网页界面（/）及其使用的 /api 接口
# BILILINK_WEB_ENABLED=true

# 是否开放 /docs 与 /openapi.json 接口文档
# BILILINK_DOCS_ENABLED=false

# 代码变更时自动重启，仅用于本地开发
# BILILINK_RELOAD=false
